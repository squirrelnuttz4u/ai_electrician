# Normalize line endings so Windows clones produce working Linux containers.
# Without this, core.autocrlf=true rewrites entrypoint.sh with CRLF and the
# container fails with: env: 'bash\r': No such file or directory
* text=auto eol=lf

# Files that must be LF, regardless of platform (executed inside Linux images)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Windows-native scripts keep CRLF
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
