# ─────────────────────────────────────────────────────────────
# AI Electrician — environment configuration
# Copy to `.env` and edit. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=aielec
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aielectrician
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (task queue) ---
REDIS_URL=redis://redis:6379/0

# --- File storage (mounted volume inside containers) ---
DATA_DIR=/data

# --- Ollama (your local LLM server) ---
# Provide the address of your shop's Ollama server, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://192.168.203.100:11434
# Reasoning model for troubleshooting answers (<=120B)
OLLAMA_CHAT_MODEL=gpt-oss:120b
# Vision model used to read schematics during extraction
OLLAMA_VISION_MODEL=qwen2.5vl:72b
# Embedding model for RAG search
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embedding vector dimension (must match the embed model; nomic-embed-text=768)
EMBED_DIM=768
# Seconds to wait on Ollama calls (vision extraction can be slow)
OLLAMA_TIMEOUT=600

# --- PDF processing ---
# DPI used to render PDF pages to images for viewing + vision extraction
RENDER_DPI=200
# If a page has fewer than this many extractable characters, treat it as
# scanned and run OCR instead of using the text layer.
TEXT_LAYER_MIN_CHARS=40

# --- Extraction (multi-pass) ---
# How many times each region of a page is read. A second pass gives an
# "agreement" signal: an item both passes find is trustworthy, one only a single
# pass reports is often a hallucination. 1 disables the signal.
EXTRACTION_PASSES=2
# Split each page into an NxN grid of overlapping tiles, each sent at full
# resolution. Helps dense ladder logic where small wire numbers are lost when a
# whole sheet is downscaled. 1 = whole page (no tiling).
# Cost is EXTRACTION_PASSES * grid^2 vision calls per page — raise deliberately.
EXTRACTION_TILE_GRID=1
EXTRACTION_TILE_OVERLAP=0.12

# --- Auth (simple LAN protection; Phase 6) ---
# Leave AUTH_ENABLED=false for an open LAN deployment.
AUTH_ENABLED=false
AUTH_SHARED_PASSWORD=change-me
AUTH_SECRET=please-generate-a-long-random-string

# --- App ---
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=*
